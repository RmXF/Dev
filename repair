#!/bin/bash
# ============================================
# AF MODAS - SCRIPT DE REPARACIÓN
# ============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}🔧 Reparando AF MODAS...${NC}"

# Detectar IP
SERVER_IP=$(hostname -I | awk '{print $1}')
if [ -z "$SERVER_IP" ]; then
    SERVER_IP="localhost"
fi

# 1. Verificar PHP
echo -e "${YELLOW}[1/5] Verificando PHP...${NC}"
if ! command -v php &> /dev/null; then
    echo -e "${RED}❌ PHP no instalado. Instalando...${NC}"
    apt update -y
    apt install -y php php-cli php-json php-curl php-mbstring libapache2-mod-php
fi

PHP_VERSION=$(php -v 2>/dev/null | head -1 | cut -d' ' -f2 | cut -d'.' -f1,2)
echo -e "${GREEN}✅ PHP $PHP_VERSION detectado${NC}"

# 2. Habilitar módulos Apache
echo -e "${YELLOW}[2/5] Configurando Apache...${NC}"
a2enmod rewrite
a2enmod headers
a2enmod php$PHP_VERSION 2>/dev/null || a2enmod php
systemctl restart apache2

# 3. Corregir permisos
echo -e "${YELLOW}[3/5] Corrigiendo permisos...${NC}"
PROJECT_DIR="/var/www/html/afmodas"
chown -R www-data:www-data "$PROJECT_DIR"
find "$PROJECT_DIR" -type d -exec chmod 755 {} \;
find "$PROJECT_DIR" -type f -exec chmod 644 {} \;
chmod 777 "$PROJECT_DIR/data"
chmod 666 "$PROJECT_DIR/data"/*.json
chmod 755 "$PROJECT_DIR/api"/*.php

# 4. Probar API
echo -e "${YELLOW}[4/5] Probando API...${NC}"
RESULT=$(curl -s -X POST "http://$SERVER_IP/afmodas/api/auth.php" \
    -H "Content-Type: application/json" \
    -d '{"code":"44202"}' 2>/dev/null)

if echo "$RESULT" | grep -q "success"; then
    echo -e "${GREEN}✅ API funcionando correctamente${NC}"
else
    echo -e "${RED}❌ API no responde correctamente${NC}"
    echo -e "${YELLOW}Respuesta: $RESULT${NC}"
    
    # Probar localmente
    echo -e "${YELLOW}Probando localmente...${NC}"
    php /var/www/html/afmodas/api/auth.php <<< '{"code":"44202"}'
fi

# 5. Verificar archivos de datos
echo -e "${YELLOW}[5/5] Verificando datos...${NC}"
DATA_DIR="/var/www/html/afmodas/data"
for file in products.json coupons.json notifications.json activity.json settings.json; do
    if [ ! -f "$DATA_DIR/$file" ]; then
        echo '[]' > "$DATA_DIR/$file"
    fi
done
chmod 666 "$DATA_DIR"/*.json

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}  ✅ REPARACIÓN COMPLETADA  ${NC}"
echo -e "${GREEN}========================================${NC}"
echo -e ""
echo -e "${BLUE}📍 Prueba ahora: ${GREEN}http://$SERVER_IP/afmodas/admin/${NC}"
echo -e "${BLUE}🔑 Código: ${YELLOW}44202${NC}"
echo -e ""
echo -e "${YELLOW}Si aún falla, revisa:${NC}"
echo -e "  tail -50 /var/log/apache2/error.log"
