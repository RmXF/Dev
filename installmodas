#!/bin/bash

# ============================================
# AF MODAS v11.0 - INSTALADOR AUTOMÁTICO
# CON MENÚ "moda" Y GESTIÓN DE USUARIOS
# ============================================

set -e

# ============================================
# COLORES
# ============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# ============================================
# DETECTAR IP
# ============================================

SERVER_IP=$(hostname -I | awk '{print $1}')

if [ -z "$SERVER_IP" ]; then
    SERVER_IP=$(curl -s ifconfig.me || echo "localhost")
fi

# ============================================
# VARIABLES
# ============================================

PROJECT_DIR="/var/www/html"
ZIP_URL="https://github.com/RmXF/Dev/raw/main/afmodas_v11.0.zip"
ZIP_FILE="/tmp/afmodas_v11.0.zip"
TEMP_DIR="/tmp/afmodas_temp"
USERS_FILE="$PROJECT_DIR/config/admin_users.json"

# ============================================
# INICIO
# ============================================

echo -e "${CYAN}========================================${NC}"
echo -e "${GREEN}   AF MODAS v11.0 - INSTALADOR${NC}"
echo -e "${CYAN}========================================${NC}"
echo -e "${BLUE}📡 IP detectada: ${GREEN}$SERVER_IP${NC}"
echo -e "${YELLOW}🚀 Iniciando instalación...${NC}"
echo ""

# ============================================
# VERIFICAR ROOT
# ============================================

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}❌ Ejecuta como root: sudo ./install.sh${NC}"
    exit 1
fi

# ============================================
# SOLICITAR CREDENCIALES
# ============================================

echo -e "${YELLOW}📝 Configuración del panel de administración:${NC}"
echo ""

read -p "Usuario para el panel admin: " ADMIN_USER

while [ -z "$ADMIN_USER" ]; do
    echo -e "${RED}❌ El usuario no puede estar vacío${NC}"
    read -p "Usuario para el panel admin: " ADMIN_USER
done

read -s -p "Contraseña para el panel admin: " ADMIN_PASS
echo ""

while [ -z "$ADMIN_PASS" ]; do
    echo -e "${RED}❌ La contraseña no puede estar vacía${NC}"
    read -s -p "Contraseña para el panel admin: " ADMIN_PASS
    echo ""
done

read -s -p "Confirmar contraseña: " ADMIN_PASS_CONFIRM
echo ""

if [ "$ADMIN_PASS" != "$ADMIN_PASS_CONFIRM" ]; then
    echo -e "${RED}❌ Las contraseñas no coinciden${NC}"
    exit 1
fi

echo ""
echo -e "${BLUE}📋 Resumen:${NC}"
echo -e "  IP del servidor: ${GREEN}$SERVER_IP${NC}"
echo -e "  Usuario admin: ${GREEN}$ADMIN_USER${NC}"
echo -e "  La web estará en: ${GREEN}http://$SERVER_IP${NC}"
echo -e "  Panel: ${GREEN}http://$SERVER_IP/admin/login.html${NC}"
echo ""

read -p "¿Continuar con la instalación? (s/N): " CONFIRMAR

if [[ ! "$CONFIRMAR" =~ ^[sS]$ ]]; then
    echo -e "${RED}❌ Instalación cancelada${NC}"
    exit 1
fi

# ============================================
# 1. INSTALAR DEPENDENCIAS
# ============================================

echo ""
echo -e "${YELLOW}[1/7] 🔄 Actualizando sistema...${NC}"

apt update -y
apt upgrade -y

echo -e "${YELLOW}[2/7] 📦 Instalando dependencias...${NC}"

apt install -y \
    apache2 \
    php \
    php-cli \
    php-json \
    php-curl \
    php-mbstring \
    libapache2-mod-php \
    unzip \
    wget \
    git \
    jq \
    rsync \
    curl

# ============================================
# DETECTAR PHP
# ============================================

PHP_VERSION=$(php -v 2>/dev/null | head -1 | cut -d' ' -f2 | cut -d'.' -f1,2)

if [ -z "$PHP_VERSION" ]; then
    PHP_VERSION="8.2"
fi

echo -e "${BLUE}🐘 PHP versión: ${GREEN}$PHP_VERSION${NC}"

# ============================================
# CONFIGURAR APACHE
# ============================================

echo -e "${YELLOW}[3/7] ⚙️ Configurando Apache...${NC}"

a2enmod rewrite
a2enmod headers
a2enmod expires

systemctl restart apache2

# ============================================
# 2. CREAR USUARIO DEL SISTEMA
# ============================================

echo -e "${YELLOW}[4/7] 👤 Creando usuario para el panel...${NC}"

useradd -m -s /bin/bash "$ADMIN_USER" 2>/dev/null || {
    echo -e "${YELLOW}⚠️ El usuario '$ADMIN_USER' ya existe${NC}"
}

echo "$ADMIN_USER:$ADMIN_PASS" | chpasswd

usermod -a -G www-data "$ADMIN_USER"

echo -e "${GREEN}✅ Usuario '$ADMIN_USER' creado${NC}"

# ============================================
# 3. DESCARGAR Y DESCOMPRIMIR
# ============================================

echo -e "${YELLOW}[5/7] 📥 Descargando AF MODAS desde GitHub...${NC}"

BACKUP_DIR="/root/afmodas_backup_$(date +%Y%m%d_%H%M%S)"

if [ -d "$PROJECT_DIR" ] && [ "$(ls -A "$PROJECT_DIR" 2>/dev/null)" ]; then

    echo -e "${YELLOW}📦 Creando backup de archivos existentes...${NC}"

    mkdir -p "$BACKUP_DIR"

    cp -r "$PROJECT_DIR"/* "$BACKUP_DIR/" 2>/dev/null || true

fi

# ============================================
# DESCARGAR ZIP
# ============================================

if command -v wget &> /dev/null; then

    wget -O "$ZIP_FILE" "$ZIP_URL" || {

        echo -e "${RED}❌ Error al descargar el ZIP${NC}"
        exit 1

    }

elif command -v curl &> /dev/null; then

    curl -L -o "$ZIP_FILE" "$ZIP_URL" || {

        echo -e "${RED}❌ Error al descargar el ZIP${NC}"
        exit 1

    }

else

    echo -e "${RED}❌ No se encontró wget o curl${NC}"
    exit 1

fi

# ============================================
# VERIFICAR ZIP
# ============================================

if [ ! -s "$ZIP_FILE" ]; then

    echo -e "${RED}❌ El archivo ZIP está vacío${NC}"
    exit 1

fi

# ============================================
# DESCOMPRIMIR
# ============================================

echo -e "${BLUE}📦 Descomprimiendo...${NC}"

rm -rf "$TEMP_DIR"
mkdir -p "$TEMP_DIR"

unzip -o "$ZIP_FILE" -d "$TEMP_DIR" || {

    echo -e "${RED}❌ Error al descomprimir${NC}"
    exit 1

}

# ============================================
# INSTALAR ARCHIVOS
# ============================================

echo -e "${BLUE}📂 Instalando en la raíz del sitio...${NC}"

rm -f "$PROJECT_DIR/index.html"

if [ -d "$TEMP_DIR/afmodas" ]; then

    cp -r "$TEMP_DIR/afmodas/"* "$PROJECT_DIR/" 2>/dev/null || true
    cp -r "$TEMP_DIR/afmodas/".* "$PROJECT_DIR/" 2>/dev/null || true

else

    cp -r "$TEMP_DIR/"* "$PROJECT_DIR/" 2>/dev/null || true
    cp -r "$TEMP_DIR/".* "$PROJECT_DIR/" 2>/dev/null || true

fi

rm -rf "$TEMP_DIR"

# ============================================
# VERIFICAR INSTALACIÓN
# ============================================

if [ ! -f "$PROJECT_DIR/index.html" ] && [ ! -f "$PROJECT_DIR/index.php" ]; then

    echo -e "${RED}❌ No se encontró index.html o index.php${NC}"
    exit 1

fi

echo -e "${GREEN}✅ Proyecto instalado${NC}"

# ============================================
# 4. CONFIGURAR AUTENTICACIÓN
# ============================================

echo -e "${YELLOW}[6/7] 🔧 Configurando autenticación...${NC}"

mkdir -p "$PROJECT_DIR/config"

# ============================================
# CREAR USUARIO ADMIN JSON
# ============================================

cat > "$USERS_FILE" << EOF
{
    "users": [
        {
            "username": "$ADMIN_USER",
            "password": "$(echo -n "$ADMIN_PASS" | sha256sum | awk '{print $1}')",
            "created": "$(date)",
            "role": "admin"
        }
    ]
}
EOF

# ============================================
# CONFIGURAR API AUTH
# ============================================

if [ -d "$PROJECT_DIR/api" ]; then

    cp "$PROJECT_DIR/api/auth.php" "$PROJECT_DIR/api/auth.php.bak" 2>/dev/null || true

    cat > "$PROJECT_DIR/api/auth.php" << 'PHPEOF'
<?php

error_reporting(0);
ini_set('display_errors', 0);

header('Content-Type: application/json');
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: POST, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    exit(0);
}

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);

    echo json_encode([
        'success' => false,
        'message' => 'Método no permitido'
    ]);

    exit;
}

$usersFile = __DIR__ . '/../config/admin_users.json';
$users = [];

if (file_exists($usersFile)) {

    $content = file_get_contents($usersFile);

    if ($content !== false) {

        $data = json_decode($content, true);

        if (
            $data &&
            isset($data['users']) &&
            is_array($data['users'])
        ) {
            $users = $data['users'];
        }

    }

}

$input = file_get_contents('php://input');
$data = json_decode($input, true);

$username = $data['username'] ?? '';
$password = $data['password'] ?? '';

if (empty($username) || empty($password)) {

    echo json_encode([
        'success' => false,
        'message' => 'Usuario y contraseña requeridos'
    ]);

    exit;

}

$auth_success = false;

foreach ($users as $user) {

    if (
        isset($user['username']) &&
        isset($user['password']) &&
        $user['username'] === $username &&
        $user['password'] === hash('sha256', $password)
    ) {

        $auth_success = true;
        break;

    }

}

if ($auth_success) {

    echo json_encode([
        'success' => true,
        'message' => 'Acceso concedido',
        'user' => $username
    ]);

} else {

    echo json_encode([
        'success' => false,
        'message' => 'Usuario o contraseña incorrectos'
    ]);

}

?>
PHPEOF

fi

# ============================================
# 5. CONFIGURAR APACHE
# ============================================

echo -e "${YELLOW}[7/7] 🌐 Configurando Apache...${NC}"

cat > /etc/apache2/sites-available/000-default.conf << EOF
<VirtualHost *:80>

    ServerAdmin webmaster@localhost

    DocumentRoot /var/www/html

    ServerName $SERVER_IP

    <Directory /var/www/html>

        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted

    </Directory>

    ErrorLog \${APACHE_LOG_DIR}/error.log

    CustomLog \${APACHE_LOG_DIR}/access.log combined

</VirtualHost>
EOF

# ============================================
# CREAR HTACCESS
# ============================================

if [ ! -f "$PROJECT_DIR/.htaccess" ]; then

    cat > "$PROJECT_DIR/.htaccess" << 'HTACCESS'
<IfModule mod_rewrite.c>

    RewriteEngine On

    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteRule ^(.*)$ index.html?url=$1 [QSA,L]

</IfModule>

<FilesMatch "\.(json|env|sql)$">

    Order Deny,Allow
    Deny from all

</FilesMatch>

Options -Indexes
HTACCESS

fi

# ============================================
# PROTEGER DATA
# ============================================

if [ -d "$PROJECT_DIR/data" ] && [ ! -f "$PROJECT_DIR/data/.htaccess" ]; then

    cat > "$PROJECT_DIR/data/.htaccess" << 'HTACCESS'
Order Deny,Allow
Deny from all
HTACCESS

fi

# ============================================
# CONFIGURAR PHP
# ============================================

PHP_CONF_DIR="/etc/php/${PHP_VERSION}/apache2/conf.d"

mkdir -p "$PHP_CONF_DIR"

cat > "$PHP_CONF_DIR/99-afmodas.ini" << 'PHPINI'
upload_max_filesize = 50M
post_max_size = 50M
max_execution_time = 300
memory_limit = 256M
display_errors = Off
PHPINI

# ============================================
# 6. PERMISOS Y LIMPIEZA
# ============================================

echo -e "${YELLOW}🔐 Configurando permisos...${NC}"

chown -R www-data:www-data "$PROJECT_DIR"

find "$PROJECT_DIR" -type d -exec chmod 755 {} \;

find "$PROJECT_DIR" -type f -exec chmod 644 {} \;

chmod 777 "$PROJECT_DIR/data" 2>/dev/null || true

chmod 666 "$PROJECT_DIR/data"/*.json 2>/dev/null || true

chmod 775 "$PROJECT_DIR/config" 2>/dev/null || true

chmod 664 "$USERS_FILE" 2>/dev/null || true

rm -f "$ZIP_FILE"

systemctl restart apache2

# ============================================
# 7. INSTALAR COMANDO "moda"
# ============================================

echo -e "${YELLOW}📝 Instalando comando 'moda'...${NC}"

cat > /usr/local/bin/moda << 'MODA_SCRIPT'
#!/bin/bash

# ============================================
# AF MODAS v11.0 - COMANDO PRINCIPAL
# ============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

SERVER_IP=$(hostname -I | awk '{print $1}')

if [ -z "$SERVER_IP" ]; then
    SERVER_IP=$(curl -s ifconfig.me || echo "localhost")
fi

PROJECT_DIR="/var/www/html"
USERS_FILE="$PROJECT_DIR/config/admin_users.json"

# ============================================
# MENÚ PRINCIPAL
# ============================================

show_menu() {

    clear

    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}   AF MODAS v11.0 - ADMINISTRADOR${NC}"
    echo -e "${CYAN}========================================${NC}"

    echo -e "${BLUE}📡 IP: ${GREEN}$SERVER_IP${NC}"

    echo -e "${BLUE}📁 Directorio: ${GREEN}$PROJECT_DIR${NC}"

    if [ -f "$PROJECT_DIR/index.html" ] || [ -f "$PROJECT_DIR/index.php" ]; then

        echo -e "${BLUE}📦 Estado: ${GREEN}Instalado${NC}"

    else

        echo -e "${BLUE}📦 Estado: ${RED}No instalado${NC}"

    fi

    echo -e "${CYAN}========================================${NC}"

    echo ""

    echo -e "${WHITE}1) 🚀 Instalar AF MODAS${NC}"
    echo -e "${WHITE}2) 👤 Agregar Nuevo Usuario Admin${NC}"
    echo -e "${WHITE}3) 📋 Lista de Usuarios Admin${NC}"
    echo -e "${WHITE}4) 🔄 Refrescar Web${NC}"
    echo -e "${WHITE}5) 🔑 Cambiar Contraseña${NC}"
    echo -e "${WHITE}6) 🗑️ Eliminar Usuario${NC}"
    echo -e "${WHITE}7) 📦 Crear Backup${NC}"
    echo -e "${WHITE}8) 🌐 Información del Sitio${NC}"
    echo -e "${WHITE}9) 📊 Estadísticas${NC}"
    echo -e "${WHITE}10) 🧹 Limpiar Cache${NC}"
    echo -e "${WHITE}11) 🔄 Reiniciar Apache${NC}"
    echo -e "${WHITE}12) ❌ Salir${NC}"

    echo ""

    echo -e "${YELLOW}Selecciona una opción (1-12):${NC}"

    read -r OPTION

    case $OPTION in

        1)
            install_afmodas
            ;;

        2)
            add_admin_user
            ;;

        3)
            list_admin_users
            ;;

        4)
            refresh_web
            ;;

        5)
            change_password
            ;;

        6)
            delete_user
            ;;

        7)
            create_backup
            ;;

        8)
            show_info
            ;;

        9)
            show_stats
            ;;

        10)
            clear_cache
            ;;

        11)
            restart_apache
            ;;

        12)

            echo -e "${GREEN}👋 ¡Hasta luego!${NC}"
            exit 0
            ;;

        *)

            echo -e "${RED}❌ Opción inválida${NC}"

            sleep 2

            show_menu
            ;;

    esac

}

# ============================================
# INSTALAR AF MODAS
# ============================================

install_afmodas() {

    echo -e "${YELLOW}📥 Descargando e instalando AF MODAS...${NC}"

    curl -s https://raw.githubusercontent.com/RmXF/Dev/main/install.sh | bash

    read -p "Presiona Enter para continuar..."

    show_menu

}

# ============================================
# AGREGAR ADMIN
# ============================================

add_admin_user() {

    clear

    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}   AGREGAR USUARIO ADMIN${NC}"
    echo -e "${CYAN}========================================${NC}"

    read -p "Nombre del nuevo usuario: " NEW_USER

    if [ -z "$NEW_USER" ]; then

        echo -e "${RED}❌ El usuario no puede estar vacío${NC}"

        read -p "Presiona Enter..."

        show_menu

        return

    fi

    read -s -p "Contraseña: " NEW_PASS

    echo ""

    read -s -p "Confirmar contraseña: " NEW_PASS_CONFIRM

    echo ""

    if [ "$NEW_PASS" != "$NEW_PASS_CONFIRM" ]; then

        echo -e "${RED}❌ No coinciden${NC}"

        read -p "Presiona Enter..."

        show_menu

        return

    fi

    useradd -m -s /bin/bash "$NEW_USER" 2>/dev/null || true

    echo "$NEW_USER:$NEW_PASS" | chpasswd

    usermod -a -G www-data "$NEW_USER"

    TEMP_FILE=$(mktemp)

    HASH_PASS=$(echo -n "$NEW_PASS" | sha256sum | awk '{print $1}')

    jq \
        --arg user "$NEW_USER" \
        --arg pass "$HASH_PASS" \
        --arg date "$(date)" \
        '.users += [{
            "username": $user,
            "password": $pass,
            "created": $date,
            "role": "admin"
        }]' \
        "$USERS_FILE" > "$TEMP_FILE" 2>/dev/null

    if [ $? -eq 0 ]; then

        mv "$TEMP_FILE" "$USERS_FILE"

        echo -e "${GREEN}✅ Usuario '$NEW_USER' agregado${NC}"

    else

        rm -f "$TEMP_FILE"

        echo -e "${RED}❌ Error al agregar el usuario${NC}"

    fi

    read -p "Presiona Enter..."

    show_menu

}

# ============================================
# LISTAR USUARIOS
# ============================================

list_admin_users() {

    clear

    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}   LISTA DE USUARIOS${NC}"
    echo -e "${CYAN}========================================${NC}"

    if [ -f "$USERS_FILE" ]; then

        jq -r '.users[] | "👤 \(.username) | 📅 \(.created) | 🔑 \(.role)"' "$USERS_FILE" 2>/dev/null

        TOTAL=$(jq '.users | length' "$USERS_FILE" 2>/dev/null || echo "0")

        echo -e "${CYAN}----------------------------------------${NC}"

        echo -e "${BLUE}Total: ${GREEN}$TOTAL usuarios${NC}"

    else

        echo -e "${RED}❌ No hay usuarios registrados${NC}"

    fi

    read -p "Presiona Enter..."

    show_menu

}

# ============================================
# REFRESCAR WEB
# ============================================

refresh_web() {

    clear

    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}   REFRESCAR WEB${NC}"
    echo -e "${CYAN}========================================${NC}"

    echo -e "${YELLOW}📥 Descargando última versión...${NC}"

    BACKUP_DIR="/root/afmodas_refresh_$(date +%Y%m%d_%H%M%S)"

    mkdir -p "$BACKUP_DIR"

    cp -r "$PROJECT_DIR"/* "$BACKUP_DIR/" 2>/dev/null || true

    echo -e "${GREEN}✅ Backup creado en: $BACKUP_DIR${NC}"

    curl -f -s -L \
        -o /tmp/afmodas.zip \
        "https://github.com/RmXF/Dev/raw/main/afmodas_v11.0.zip"

    if [ ! -s /tmp/afmodas.zip ]; then

        echo -e "${RED}❌ No se pudo descargar la actualización${NC}"

        read -p "Presiona Enter..."

        show_menu

        return

    fi

    rm -rf /tmp/afmodas_temp

    mkdir -p /tmp/afmodas_temp

    unzip -o /tmp/afmodas.zip -d /tmp/afmodas_temp > /dev/null 2>&1

    if [ -d "/tmp/afmodas_temp/afmodas" ]; then

        cp -r "/tmp/afmodas_temp/afmodas/"* "$PROJECT_DIR/" 2>/dev/null || true

    else

        cp -r "/tmp/afmodas_temp/"* "$PROJECT_DIR/" 2>/dev/null || true

    fi

    rm -rf /tmp/afmodas_temp
    rm -f /tmp/afmodas.zip

    chown -R www-data:www-data "$PROJECT_DIR"

    systemctl restart apache2

    echo -e "${GREEN}✅ Web refrescada${NC}"

    read -p "Presiona Enter..."

    show_menu

}

# ============================================
# CAMBIAR CONTRASEÑA
# ============================================

change_password() {

    clear

    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}   CAMBIAR CONTRASEÑA${NC}"
    echo -e "${CYAN}========================================${NC}"

    jq -r '.users[].username' "$USERS_FILE" 2>/dev/null

    echo ""

    read -p "Nombre del usuario: " USERNAME

    read -s -p "Nueva contraseña: " NEW_PASS

    echo ""

    read -s -p "Confirmar: " NEW_PASS_CONFIRM

    echo ""

    if [ "$NEW_PASS" != "$NEW_PASS_CONFIRM" ]; then

        echo -e "${RED}❌ No coinciden${NC}"

        read -p "Presiona Enter..."

        show_menu

        return

    fi

    TEMP_FILE=$(mktemp)

    HASH_PASS=$(echo -n "$NEW_PASS" | sha256sum | awk '{print $1}')

    jq \
        --arg user "$USERNAME" \
        --arg pass "$HASH_PASS" \
        --arg date "$(date)" \
        '.users |= map(
            if .username == $user
            then . + {
                "password": $pass,
                "updated": $date
            }
            else .
            end
        )' \
        "$USERS_FILE" > "$TEMP_FILE" 2>/dev/null

    if [ $? -eq 0 ]; then

        mv "$TEMP_FILE" "$USERS_FILE"

        echo "$USERNAME:$NEW_PASS" | chpasswd 2>/dev/null || true

        echo -e "${GREEN}✅ Contraseña actualizada${NC}"

    else

        rm -f "$TEMP_FILE"

        echo -e "${RED}❌ Error al actualizar la contraseña${NC}"

    fi

    read -p "Presiona Enter..."

    show_menu

}

# ============================================
# ELIMINAR USUARIO
# ============================================

delete_user() {

    clear

    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}   ELIMINAR USUARIO${NC}"
    echo -e "${CYAN}========================================${NC}"

    jq -r '.users[].username' "$USERS_FILE" 2>/dev/null

    echo ""

    read -p "Usuario a eliminar: " USERNAME

    TOTAL=$(jq '.users | length' "$USERS_FILE" 2>/dev/null || echo "0")

    if [ "$TOTAL" -le 1 ]; then

        echo -e "${RED}❌ No puedes eliminar el último usuario${NC}"

        read -p "Presiona Enter..."

        show_menu

        return

    fi

    read -p "¿Estás seguro? (s/N): " CONFIRMAR

    if [[ ! "$CONFIRMAR" =~ ^[sS]$ ]]; then

        echo -e "${YELLOW}Cancelado${NC}"

        read -p "Presiona Enter..."

        show_menu

        return

    fi

    TEMP_FILE=$(mktemp)

    jq \
        --arg user "$USERNAME" \
        '.users |= map(select(.username != $user))' \
        "$USERS_FILE" > "$TEMP_FILE" 2>/dev/null

    if [ $? -eq 0 ]; then

        mv "$TEMP_FILE" "$USERS_FILE"

        userdel -r "$USERNAME" 2>/dev/null || true

        echo -e "${GREEN}✅ Usuario eliminado${NC}"

    else

        rm -f "$TEMP_FILE"

        echo -e "${RED}❌ Error al eliminar el usuario${NC}"

    fi

    read -p "Presiona Enter..."

    show_menu

}

# ============================================
# CREAR BACKUP
# ============================================

create_backup() {

    clear

    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}   CREAR BACKUP${NC}"
    echo -e "${CYAN}========================================${NC}"

    BACKUP_FILE="/root/afmodas_backup_$(date +%Y%m%d_%H%M%S).tar.gz"

    tar -czf "$BACKUP_FILE" -C "$PROJECT_DIR" .

    echo -e "${GREEN}✅ Backup creado: $BACKUP_FILE${NC}"

    echo -e "${BLUE}📊 Tamaño: ${GREEN}$(du -h "$BACKUP_FILE" | awk '{print $1}')${NC}"

