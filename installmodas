# ============================================
# LIMPIAR CACHE
# ============================================

clear_cache() {

    clear

    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}   LIMPIAR CACHE${NC}"
    echo -e "${CYAN}========================================${NC}"

    rm -rf /var/cache/apache2/* 2>/dev/null || true

    rm -rf /var/lib/php/sessions/* 2>/dev/null || true

    rm -rf /tmp/afmodas_* 2>/dev/null || true

    systemctl restart apache2

    echo -e "${GREEN}✅ Cache limpiada${NC}"

    read -p "Presiona Enter..."

    show_menu

}

# ============================================
# REINICIAR APACHE
# ============================================

restart_apache() {

    clear

    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}   REINICIAR APACHE${NC}"
    echo -e "${CYAN}========================================${NC}"

    echo -e "${YELLOW}🔄 Reiniciando Apache...${NC}"

    systemctl restart apache2

    sleep 2

    if systemctl is-active --quiet apache2; then

        echo -e "${GREEN}✅ Apache está funcionando correctamente${NC}"

    else

        echo -e "${RED}❌ Apache no pudo iniciarse${NC}"

        systemctl status apache2 --no-pager

    fi

    read -p "Presiona Enter..."

    show_menu

}

