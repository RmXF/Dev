        sleep 2
        return
    fi
    
    timestamp=$(date +"%Y%m%d_%H%M%S")
    backup_file="$WEB_DIR/index_backup_$timestamp.html"
    
    echo -e "${YELLOW}📦 Creando respaldo...${NC}"
    cp $WEB_DIR/index.html $backup_file
    
