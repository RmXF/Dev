# Función para mostrar spinner de carga
show_spinner() {
    local pid=$1
    local delay=0.1
    local spinstr='|/-\'
    while [ "$(ps a | awk '{print $1}' | grep $pid)" ]; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

# Función para instalar sitio desde GitHub
install_site() {
    clear
    show_banner
    echo -e "${BLUE}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}              🚀 INSTALANDO SITIO WEB                    ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    echo -e "${YELLOW}📦 Actualizando sistema...${NC}"
    apt update -y > /dev/null 2>&1 &
    show_spinner $!
    echo -e "${GREEN}✅ Sistema actualizado${NC}"
    
    echo -e "${YELLOW}📦 Instalando dependencias...${NC}"
    apt install nginx unzip wget curl -y > /dev/null 2>&1 &
    show_spinner $!
    echo -e "${GREEN}✅ Dependencias instaladas${NC}"
    
    echo -e "${YELLOW}🔄 Configurando Nginx...${NC}"
    systemctl start nginx > /dev/null 2>&1
    systemctl enable nginx > /dev/null 2>&1
    echo -e "${GREEN}✅ Nginx configurado${NC}"
    
    echo -e "${YELLOW}📁 Preparando directorio web...${NC}"
    cd $WEB_DIR
    rm -rf *
    echo -e "${GREEN}✅ Directorio limpio${NC}"
    
    echo -e "${YELLOW}📥 Descargando sitio desde GitHub...${NC}"
    wget -q https://raw.githubusercontent.com/RmXF/Dev/main/afmoda.zip &
    show_spinner $!
    
    if [ ! -f "afmoda.zip" ]; then
        echo -e "${RED}❌ Error: No se pudo descargar afmoda.zip${NC}"
        sleep 3
        return
    fi
    echo -e "${GREEN}✅ Descarga completada${NC}"
    
    echo -e "${YELLOW}📦 Descomprimiendo sitio...${NC}"
    unzip -q afmoda.zip
    echo -e "${GREEN}✅ Descompresión completada${NC}"
    
    echo -e "${YELLOW}📁 Organizando archivos...${NC}"
    if [ -d "afmoda" ]; then
        cp -r afmoda/* . 2>/dev/null
        rm -rf afmoda
    fi
    rm -f afmoda.zip
    echo -e "${GREEN}✅ Archivos organizados${NC}"
    
    echo -e "${YELLOW}🔒 Estableciendo permisos...${NC}"
    chown -R www-data:www-data $WEB_DIR
    chmod -R 755 $WEB_DIR
    echo -e "${GREEN}✅ Permisos establecidos${NC}"
    
    echo -e "${YELLOW}🔄 Reiniciando Nginx...${NC}"
    systemctl restart nginx
    echo -e "${GREEN}✅ Nginx reiniciado${NC}"
    
    clear
    show_banner
    echo -e "${GREEN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║${NC}              ✅ SITIO INSTALADO CORRECTAMENTE            ${GREEN}║${NC}"
    echo -e "${GREEN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${CYAN}🌐 Abre en tu navegador:${NC}"
    echo -e "${WHITE}   http://$(curl -s ifconfig.me)${NC}"
    echo ""
    echo -e "${CYAN}📁 Archivos instalados en:${NC}"
    echo -e "${WHITE}   $WEB_DIR${NC}"
    echo ""
    echo -e "${YELLOW}💡 Puedes usar los comandos rápidos:${NC}"
    echo -e "   ${WHITE}moda-add${NC}     - Agregar nueva prenda"
    echo -e "   ${WHITE}moda-status${NC}  - Ver estado del sitio"
    echo -e "   ${WHITE}moda-backup${NC}  - Crear respaldo"
    echo ""
    read -p "Presiona Enter para continuar..."
}

# Función para cargar nueva prenda
add_product() {
    clear
    show_banner
    echo -e "${BLUE}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}              ➕ CARGAR NUEVA PRENDA                     ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    # Verificar que products.js existe
    if [ ! -f "$WEB_DIR/products.js" ]; then
        echo -e "${RED}❌ Error: No se encuentra products.js en $WEB_DIR${NC}"
        echo -e "${YELLOW}💡 Primero instala el sitio web (opción 1)${NC}"
        sleep 3
        return
    fi
    
    echo -e "${CYAN}📝 Ingresa los datos de la nueva prenda:${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    
    # Recolectar datos con validación
    while true; do
        read -p "ID del producto (número): " id
        if [[ "$id" =~ ^[0-9]+$ ]]; then
            break
        else
            echo -e "${RED}❌ ID debe ser un número${NC}"
        fi
    done
    
    read -p "Nombre: " name
    while [[ -z "$name" ]]; do
        echo -e "${RED}❌ El nombre es obligatorio${NC}"
        read -p "Nombre: " name
    done
    
    echo -e "${YELLOW}Categorías disponibles: Hombre, Mujer, Accesorios${NC}"
    read -p "Categoría: " category
    
    read -p "Subcategoría (ej: Remeras, Buzos, Pantalones): " subcategory
    read -p "Tipo (ej: Oversize, Classic, Urban): " type
    
    while true; do
        read -p "Precio (sin puntos, ej: 24999): " price
        if [[ "$price" =~ ^[0-9]+$ ]]; then
            break
        else
            echo -e "${RED}❌ Precio debe ser un número${NC}"
        fi
    done
    
    read -p "Precio anterior (opcional, ej: 29999): " old_price
    read -p "Etiqueta/Badge (NUEVO/DESTACADO/OFERTA): " badge
    read -p "Descripción breve: " description
    
    read -p "Talles (separados por coma, ej: S,M,L,XL): " sizes_input
    while [[ -z "$sizes_input" ]]; do
        echo -e "${RED}❌ Los talles son obligatorios${NC}"
        read -p "Talles (separados por coma): " sizes_input
    done
    
    read -p "¿Es destacado? (si/no): " featured_input
    while true; do
        read -p "Stock disponible: " stock
        if [[ "$stock" =~ ^[0-9]+$ ]]; then
            break
        else
            echo -e "${RED}❌ Stock debe ser un número${NC}"
        fi
    done
    
    # Formatear datos
    sizes_array=$(echo "$sizes_input" | sed 's/,/","/g')
    featured=$([ "$featured_input" = "si" ] && echo "true" || echo "false")
    old_price_formatted=$([ -z "$old_price" ] && echo "null" || echo "$old_price")
    
    # Crear el nuevo producto
    new_product="
    {
        id: $id,
        name: \"$name\",
        category: \"$category\",
        subcategory: \"$subcategory\",
        type: \"$type\",
        price: $price,
        oldPrice: $old_price_formatted,
        badge: \"$badge\",
        image: \"https://placehold.co/600x800/25222d/a78bfa?text=AF+MODA\",
        description: \"$description\",
        sizes: [\"$sizes_array\"],
        featured: $featured,
        stock: $stock,
        active: true
    }"
    
    echo ""
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}📋 Resumen de la prenda:${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo "$new_product"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    read -p "¿Confirmar y agregar al catálogo? (s/n): " confirm
    
    if [ "$confirm" != "s" ]; then
        echo -e "${YELLOW}⏹ Operación cancelada${NC}"
        sleep 2
        return
    fi
    
    # Hacer backup del archivo original
    cp $WEB_DIR/products.js $WEB_DIR/products.js.bak
    
    # Insertar el nuevo producto
    cd $WEB_DIR
    
    # Buscar el último producto y agregar coma, luego el nuevo
    # Esta es una forma más segura: reemplazar el ] final con el nuevo producto + ]
    sed -i "s/];$/${new_product}\n];/" products.js
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✅ ¡Producto agregado exitosamente!${NC}"
        systemctl restart nginx
        echo ""
        echo -e "${CYAN}📦 Nuevo producto añadido al catálogo${NC}"
        echo -e "${YELLOW}🌐 Actualiza la página para ver el cambio${NC}"
    else
        echo -e "${RED}❌ Error al agregar el producto${NC}"
        echo -e "${YELLOW}Se restaurará el archivo original...${NC}"
        mv products.js.bak products.js
    fi
    
    echo ""
    read -p "Presiona Enter para continuar..."
}

# Función para actualizar desde ZIP
update_from_zip() {
    clear
    show_banner
    echo -e "${BLUE}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}              🔄 ACTUALIZAR SITIO DESDE ZIP               ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    echo -e "${CYAN}📦 Ingresa el enlace directo del ZIP:${NC}"
    echo -e "${YELLOW}💡 Ejemplo: https://ejemplo.com/mi-sitio.zip${NC}"
    echo ""
    read -p "➜ URL del ZIP: " zip_url
    
    if [ -z "$zip_url" ]; then
        echo -e "${RED}❌ URL vacía, cancelando...${NC}"
        sleep 2
        return
    fi
    
    echo ""
    echo -e "${YELLOW}📥 Descargando ZIP desde: $zip_url${NC}"
    cd $WEB_DIR
    
    # Hacer backup primero
    echo -e "${YELLOW}💾 Creando respaldo...${NC}"
    timestamp=$(date +"%Y%m%d_%H%M%S")
    mkdir -p $WEB_DIR/backups
    zip -r "backups/backup_$timestamp.zip" . -x "backups/*" > /dev/null 2>&1 &
    show_spinner $!
    echo -e "${GREEN}✅ Respaldo creado${NC}"
    
    echo -e "${YELLOW}📥 Descargando actualización...${NC}"
    wget -q -O update.zip "$zip_url" &
    show_spinner $!
    
    if [ ! -f "update.zip" ]; then
        echo -e "${RED}❌ Error al descargar el archivo${NC}"
        sleep 3
        return
    fi
    echo -e "${GREEN}✅ Descarga completada${NC}"
    
    echo -e "${YELLOW}🔄 Extrayendo archivos...${NC}"
    # Limpiar solo los archivos principales
    find . -maxdepth 1 -type f ! -name "update.zip" ! -name "*.bak" -exec rm -f {} \;
    find . -maxdepth 1 -type d ! -name "backups" ! -name "." -exec rm -rf {} \;
    
    unzip -q update.zip &
    show_spinner $!
    
    # Si hay una carpeta con el mismo nombre, mover contenido
    for dir in */; do
        if [ -d "$dir" ] && [ "$dir" != "backups/" ]; then
            cp -r "$dir"* . 2>/dev/null
            rm -rf "$dir"
            break
        fi
    done
    
    rm -f update.zip
    
    chown -R www-data:www-data $WEB_DIR
    chmod -R 755 $WEB_DIR
    
    systemctl restart nginx
    
    clear
    show_banner
    echo -e "${GREEN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║${NC}              ✅ SITIO ACTUALIZADO CORRECTAMENTE          ${GREEN}║${NC}"
    echo -e "${GREEN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}💾 Respaldo guardado en:${NC}"
    echo -e "${WHITE}   backups/backup_$timestamp.zip${NC}"
    echo ""
    read -p "Presiona Enter para continuar..."
}

# Función para ver estado
check_status() {
    clear
    show_banner
    echo -e "${BLUE}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}              📊 ESTADO DEL SITIO                        ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    echo -e "${CYAN}📁 Directorio web:${NC}"
    echo -e "   ${WHITE}$WEB_DIR${NC}"
    echo ""
    
    echo -e "${CYAN}📄 Archivos principales:${NC}"
    ls -lh $WEB_DIR/*.html $WEB_DIR/*.js $WEB_DIR/*.css 2>/dev/null | awk '{print "   " $9 " - " $5}'
    
    echo ""
    echo -e "${CYAN}📊 Productos en catálogo:${NC}"
    if [ -f "$WEB_DIR/products.js" ]; then
        count=$(grep -c "id:" $WEB_DIR/products.js 2>/dev/null || echo "0")
        echo -e "   ${GREEN}Productos encontrados: $count${NC}"
        
        echo ""
        echo -e "${CYAN}📋 Últimos productos agregados:${NC}"
        grep -A 3 "id:" $WEB_DIR/products.js | tail -12 | sed 's/^[ \t]*/   /'
    else
        echo -e "   ${RED}❌ products.js no encontrado${NC}"
    fi
    
    echo ""
    echo -e "${CYAN}🔄 Estado de Nginx:${NC}"
    systemctl status nginx --no-pager | grep "Active:" | sed 's/^/   /'
    
    echo ""
    echo -e "${CYAN}🌐 IP del servidor:${NC}"
    echo -e "   ${WHITE}http://$(curl -s ifconfig.me)${NC}"
    
    echo ""
    echo -e "${CYAN}💾 Respaldos disponibles:${NC}"
    ls -lh $WEB_DIR/backups/*.zip 2>/dev/null | awk '{print "   " $9 " - " $5}' || echo "   No hay respaldos"
    
    echo ""
    read -p "Presiona Enter para continuar..."
}

# Función para respaldar
backup_site() {
    clear
    show_banner
    echo -e "${BLUE}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}              💾 RESPALDAR SITIO                         ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    timestamp=$(date +"%Y%m%d_%H%M%S")
    backup_dir="$WEB_DIR/backups"
    backup_file="backup_$timestamp.zip"
    
    mkdir -p $backup_dir
    
    echo -e "${YELLOW}📦 Creando respaldo...${NC}"
    cd $WEB_DIR
    zip -r "$backup_dir/$backup_file" . -x "backups/*" > /dev/null 2>&1 &
    show_spinner $!
    
    if [ -f "$backup_dir/$backup_file" ]; then
        size=$(du -h "$backup_dir/$backup_file" | cut -f1)
        echo -e "${GREEN}✅ Respaldo creado exitosamente${NC}"
        echo ""
        echo -e "${CYAN}📁 Archivo:${NC}"
        echo -e "   ${WHITE}$backup_dir/$backup_file${NC}"
        echo -e "${CYAN}📊 Tamaño:${NC}"
        echo -e "   ${WHITE}$size${NC}"
    else
        echo -e "${RED}❌ Error al crear respaldo${NC}"
    fi
    
    echo ""
    read -p "Presiona Enter para continuar..."
}

# Función para restaurar
restore_backup() {
    clear
    show_banner
    echo -e "${BLUE}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}              🔁 RESTAURAR RESPALDO                      ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    backup_dir="$WEB_DIR/backups"
    
    if [ ! -d "$backup_dir" ] || [ -z "$(ls -A $backup_dir 2>/dev/null)" ]; then
        echo -e "${RED}❌ No hay respaldos disponibles${NC}"
        sleep 2
        return
    fi
    
    echo -e "${CYAN}📂 Respaldos disponibles:${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    ls -lh $backup_dir/*.zip 2>/dev/null | awk '{print NR ") " $9 " - " $5}'
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    read -p "Selecciona el número del respaldo: " num
    
    backup_file=$(ls $backup_dir/*.zip 2>/dev/null | sed -n "${num}p")
    
    if [ -z "$backup_file" ]; then
        echo -e "${RED}❌ Selección inválida${NC}"
        sleep 2
        return
    fi
    
    echo -e "${YELLOW}🔄 Restaurando $backup_file...${NC}"
    
    cd $WEB_DIR
    # Limpiar todo menos backups
    find . -maxdepth 1 ! -name "backups" ! -name "." -exec rm -rf {} \;
    
    unzip -q "$backup_file" &
    show_spinner $!
    
    chown -R www-data:www-data $WEB_DIR
    chmod -R 755 $WEB_DIR
    
    systemctl restart nginx
    
    echo -e "${GREEN}✅ Sitio restaurado correctamente${NC}"
    echo ""
    read -p "Presiona Enter para continuar..."
}

# Función para configurar comandos rápidos
setup_commands() {
    clear
    show_banner
    echo -e "${BLUE}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}              🔧 CONFIGURAR COMANDOS RÁPIDOS             ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    echo -e "${CYAN}📌 Comandos disponibles para instalar:${NC}"
    echo ""
    echo -e "  ${GREEN}1)${NC} ${WHITE}moda-add${NC}      - Agregar nueva prenda"
    echo -e "  ${GREEN}2)${NC} ${WHITE}moda-status${NC}   - Ver estado del sitio"
    echo -e "  ${GREEN}3)${NC} ${WHITE}moda-backup${NC}   - Crear respaldo"
    echo -e "  ${GREEN}4)${NC} ${WHITE}moda-restore${NC}  - Restaurar respaldo"
    echo -e "  ${GREEN}5)${NC} ${WHITE}moda-update${NC}   - Actualizar desde ZIP"
    echo -e "  ${GREEN}6)${NC} ${WHITE}moda-install${NC}  - Instalar sitio"
    echo ""
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    read -p "Selecciona un comando para instalar (1-6): " cmd_choice
    
    case $cmd_choice in
        1) cmd_name="moda-add"; cmd_func="add_product" ;;
        2) cmd_name="moda-status"; cmd_func="check_status" ;;
        3) cmd_name="moda-backup"; cmd_func="backup_site" ;;
        4) cmd_name="moda-restore"; cmd_func="restore_backup" ;;
        5) cmd_name="moda-update"; cmd_func="update_from_zip" ;;
        6) cmd_name="moda-install"; cmd_func="install_site" ;;
        *) echo -e "${RED}❌ Opción inválida${NC}"; sleep 2; return ;;
    esac
    
    # Crear el comando rápido
    cat > "/usr/local/bin/$cmd_name" << EOF
#!/bin/bash
$INSTALL_PATH --$cmd_func
EOF
    
    chmod +x "/usr/local/bin/$cmd_name"
    
    echo -e "${GREEN}✅ Comando '$cmd_name' instalado correctamente${NC}"
    echo -e "${YELLOW}💡 Ahora puedes ejecutar: $cmd_name${NC}"
    echo ""
    read -p "Presiona Enter para continuar..."
}

# ============================================
# PROCESAMIENTO DE ARGUMENTOS
# ============================================

# Si se pasa un argumento, ejecutar esa función directamente
if [ $# -gt 0 ]; then
    case $1 in
        --add_product|add|agregar) add_product; exit 0 ;;
        --check_status|status|estado) check_status; exit 0 ;;
        --backup_site|backup|respaldar) backup_site; exit 0 ;;
        --restore_backup|restore|restaurar) restore_backup; exit 0 ;;
        --update_from_zip|update|actualizar) update_from_zip; exit 0 ;;
        --install_site|install|instalar) install_site; exit 0 ;;
        --help|help|-h)
            echo "Uso: moda [comando]"
            echo ""
            echo "Comandos disponibles:"
            echo "  add, agregar          - Agregar nueva prenda"
            echo "  status, estado        - Ver estado del sitio"
            echo "  backup, respaldar     - Crear respaldo"
            echo "  restore, restaurar    - Restaurar respaldo"
            echo "  update, actualizar    - Actualizar desde ZIP"
            echo "  install, instalar     - Instalar sitio"
            echo "  help                  - Mostrar esta ayuda"
            echo ""
            echo "Sin argumentos: ejecuta el menú interactivo"
            exit 0
            ;;
        *)
            echo -e "${RED}❌ Comando desconocido: $1${NC}"
            echo -e "${YELLOW}Usa 'moda help' para ver los comandos disponibles${NC}"
            exit 1
            ;;
    esac
fi

# ============================================
# PROGRAMA PRINCIPAL (menú interactivo)
# ============================================

# Verificar que se ejecute como root
if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}❌ Este script debe ejecutarse como root${NC}"
    echo -e "${YELLOW}💡 Usa: sudo moda${NC}"
    exit 1
fi

# Bucle principal
while true; do
    show_menu
    read option
    
    case $option in
        1) install_site ;;
        2) add_product ;;
        3) update_from_zip ;;
        4) check_status ;;
        5) backup_site ;;
        6) restore_backup ;;
        7) setup_commands ;;
        8) 
            echo -e "${GREEN}👋 ¡Hasta luego!${NC}"
            exit 0
            ;;
        *)
            echo -e "${RED}❌ Opción inválida. Intenta de nuevo.${NC}"
            sleep 1
            ;;
    esac
done
